# ---------------------------------------------------------------------------
# Flask Security Lab - example environment configuration
# Copy to .env and adjust. NEVER commit a real .env (it is gitignored).
# ---------------------------------------------------------------------------

# Flask secret key (session signing, etc.). The app ships an obviously-fake
# default; set a real random value for anything beyond a throwaway demo, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=lab-insecure-development-key-change-me-please

# Environment selector: dev | lab | production | test
#   dev        -> DEBUG on  (default)
#   lab/production -> DEBUG off, defenses on (how the lab is meant to run)
FLASK_ENV=dev

# --- Blue Team master switch -----------------------------------------------
# When false, the app behaves like naive, unprotected code (no headers, no WAF,
# no request-level detection). This is the single most important toggle.
BLUE_TEAM_ENABLED=true

# Mini-WAF: blocks malicious-looking requests. Detection/logging runs regardless.
WAF_ENABLED=true

# Rate limiting (Flask-Limiter).
RATELIMIT_ENABLED=true
# Storage backend for the limiter. memory:// is fine for local/dev.
# RATELIMIT_STORAGE_URI=memory://

# --- Database --------------------------------------------------------------
# SQLite path. Defaults to src/lab/data/lab.db. Use :memory: for an ephemeral db.
# DATABASE_PATH=src/lab/data/lab.db

# --- Network binding -------------------------------------------------------
# SECURITY: keep HOST on the loopback for local runs. The app is intentionally
# vulnerable and must never be exposed to a network. (Inside Docker the
# container uses HOST=0.0.0.0, but compose only publishes on 127.0.0.1.)
HOST=127.0.0.1
PORT=5000
