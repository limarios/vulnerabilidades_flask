# Normalize line endings: LF in the repository, checked out natively per OS.
* text=auto eol=lf

# Explicitly text
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Binary (never touch)
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.db    binary
